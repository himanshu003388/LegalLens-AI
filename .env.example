# LegalLens AI - Environment Configuration
# If left blank, LegalLens AI automatically operates in Zero-Key Local Mode
# using its built-in deterministic legal intelligence engine.

# Google Gemini API Key (Recommended - Free Tier Available at https://aistudio.google.com/app/apikey)
# Supports Gemini 1.5 Flash / Gemini 2.0 Flash / Gemini 1.5 Pro
GEMINI_API_KEY=

# OpenAI API Key (Optional) - Supports GPT-4o / GPT-4o-mini
OPENAI_API_KEY=

# Anthropic API Key (Optional) - Supports Claude 3.5 Sonnet
ANTHROPIC_API_KEY=

# AI Provider choice: "gemini", "openai", "anthropic", "local", or "auto"
AI_PROVIDER=gemini
